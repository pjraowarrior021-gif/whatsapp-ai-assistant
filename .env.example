# ==============================================================================
# Personal WhatsApp AI Assistant - Environment Configuration
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#    copy .env.example .env (Windows PowerShell/CMD)
# 2. Fill in your actual credentials.
# 3. NEVER commit your '.env' file to source control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
# Logging format: 'text' (default) or 'json' for structured cloud observability
LOG_FORMAT=text
# Optional secret token to authenticate /metrics and /diagnostic endpoints (Bearer token required in production)
OPS_TOKEN=

# ------------------------------------------------------------------------------
# 1. Google Gemini API Configuration
# Get a free API key: https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE
# Primary model ID (single source of truth)
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated fallback models in trial order (excluding primary)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.7
# Enable real-time Google Search grounding (default: false; toggle in chat via /search on|off)
ENABLE_SEARCH_GROUNDING=false

# ------------------------------------------------------------------------------
# 2. WhatsApp Cloud API (Meta for Developers) Configuration
# https://developers.facebook.com/apps
# ------------------------------------------------------------------------------
# Meta Graph API Token (System User permanent token or Temporary 24-hr token)
WHATSAPP_TOKEN=EAAG_YOUR_META_WHATSAPP_ACCESS_TOKEN_HERE

# Phone Number ID (From WhatsApp > API Setup in Meta developer portal)
WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Custom secret token created by you for Webhook handshake verification
# Meta sends this during webhook registration; must match timing-safe comparison exactly
WHATSAPP_VERIFY_TOKEN=create_a_strong_random_secret_string_here_e_g_random_token_123

# Meta App Secret (From App Dashboard > App Settings > Basic > App Secret)
# Used to verify incoming x-hub-signature-256 HMAC-SHA256 headers
WHATSAPP_APP_SECRET=your_meta_app_secret_32_hex_chars

# WhatsApp Graph API version
WHATSAPP_API_VERSION=v21.0

# Optional test-mode only bypass for CI testing (honored strictly when NODE_ENV=test)
SKIP_SIGNATURE_VERIFICATION=false

# ------------------------------------------------------------------------------
# 3. Media Download Hardening
# ------------------------------------------------------------------------------
# Maximum allowed media size in bytes (default: 100MB)
MEDIA_MAX_BYTES=104857600
# Media download timeout in milliseconds (default: 60 seconds)
MEDIA_FETCH_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# 3b. Generative Video Configuration (/video, /reel, /animate)
# ------------------------------------------------------------------------------
# Optional API key for AI video generation.
# Video models (Veo 3.1, Seedance, Wan) require a valid Pollinations API key.
# Get a key with starter pollen credits at: https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=
# Preferred video generation model (default: google/veo-3.1-fast)
# Alternatives: bytedance/seedance-1-pro-fast, prunaai/p-video, alibaba/wan-2.2-fast
POLLINATIONS_VIDEO_MODEL=google/veo-3.1-fast

# ------------------------------------------------------------------------------
# 4. Privacy & Access Control Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of authorized phone numbers in international format
# without '+' symbol or spaces (e.g., 919876543210,14155552671).
# Senders not in this list will be immediately rejected with an access notice.
ALLOWED_PHONE_NUMBERS=919876543210

# Inactivity timeout in minutes before in-memory conversation is wiped from RAM
SESSION_TIMEOUT_MINUTES=15

# Maximum conversation turns retained in memory (sliding window: 5 user + 5 AI)
MAX_CONTEXT_TURNS=10

# Global network rate limit settings (DoS prevention)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_WINDOW=20

# Per-user sliding-window rate limit
USER_RATE_LIMIT_MAX=10
USER_RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------------------------
# 5. State Storage & Persistence (Memory vs Redis)
# ------------------------------------------------------------------------------
# State storage backend: 'memory' (default in-RAM) or 'redis' (production multi-instance)
STATE_BACKEND=memory
# Optional Redis connection URL (e.g. redis://default:password@host:6379 or rediss:// for TLS)
REDIS_URL=
# Directory for persistent file storage (reminders, todos)
DATA_DIR=.data

# ------------------------------------------------------------------------------
# 6. Quotas & Reminders
# ------------------------------------------------------------------------------
# Daily requests allowed per authorized user (resets at 00:00 UTC)
MAX_REQUESTS_PER_USER_PER_DAY=200
# Global Gemini requests budget per day across all users
MAX_GEMINI_REQUESTS_PER_DAY=1400

# Reminders & To-Dos persistence: 'false' (default) to keep reminders and todos in volatile RAM.
# Set to 'true' only if you explicitly want atomically persisted reminders in DATA_DIR.
REMINDERS_PERSIST=false

# ------------------------------------------------------------------------------
# 7. Message Queue & Concurrency Control
# ------------------------------------------------------------------------------
# Maximum concurrent message processing pipelines (default: 4)
MESSAGE_CONCURRENCY=4
# Maximum retry attempts for transient external API errors (429/5xx) (default: 3)
QUEUE_MAX_RETRIES=3
# Maximum buffer size before queue backpressure drops requests (default: 1000)
QUEUE_MAX_SIZE=1000
# Maximum time in milliseconds to wait for active tasks during shutdown (default: 10000)
SHUTDOWN_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 8. Advanced Agentic Features & Integrations
# ------------------------------------------------------------------------------
# Enables Gemini function calling (real-time weather, clock, auto-reminders, auto-todos)
ENABLE_AI_TOOLS=false

# Opt-in WhatsApp group support: comma-separated allowed group IDs
ALLOWED_GROUP_IDS=

# Prefix required in group messages to trigger assistant replies (default: '/')
GROUP_TRIGGER_PREFIX=/

# Pre-approved Meta WhatsApp message template name for proactive reminders outside 24h window
TEMPLATE_DIGEST_NAME=
TEMPLATE_DIGEST_LANG=en
