# ==============================================================================
# Personal WhatsApp AI Assistant - Environment Configuration
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#    copy .env.example .env (Windows PowerShell/CMD)
# 2. Fill in your actual credentials.
# 3. NEVER commit your '.env' file to source control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Google Gemini API Configuration
# Get a free API key: https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# 2. WhatsApp Cloud API (Meta for Developers) Configuration
# https://developers.facebook.com/apps
# ------------------------------------------------------------------------------
# Meta Graph API Token (System User token or Temporary 24-hr Test token)
WHATSAPP_TOKEN=EAAG_YOUR_META_WHATSAPP_ACCESS_TOKEN_HERE

# Phone Number ID (From WhatsApp > API Setup in Meta developer portal)
WHATSAPP_PHONE_NUMBER_ID=109876543210987

# Custom secret token created by you for Webhook handshake verification
WHATSAPP_VERIFY_TOKEN=create_a_strong_random_secret_string_here_e_g_random_token_123

# Meta App Secret (From App Dashboard > App Settings > Basic > App Secret)
# Used to verify x-hub-signature-256 HMAC-SHA256 headers
WHATSAPP_APP_SECRET=your_meta_app_secret_32_hex_chars

# WhatsApp Graph API version
WHATSAPP_API_VERSION=v21.0

# ------------------------------------------------------------------------------
# 3. Privacy & Access Control Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of authorized phone numbers in international E.164 format
# without '+' symbol or spaces (e.g., 919876543210,14155552671).
# Any sender not in this list will be immediately rejected.
ALLOWED_PHONE_NUMBERS=919876543210

# Inactivity timeout in minutes before in-memory conversation is wiped from RAM
SESSION_TIMEOUT_MINUTES=15

# Maximum conversation turns retained in memory (sliding window: 5 user + 5 AI)
MAX_CONTEXT_TURNS=10

# Local rate limit settings (DoS prevention)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_WINDOW=20
