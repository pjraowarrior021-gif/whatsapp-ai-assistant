{
  "name": "whatsapp-group-manager-bot",
  "version": "1.1.0",
  "description": "WhatsApp Group Manager Bot & AI Assistant powered by Google Gemini, Baileys Autonomous Group Administrator, and Meta WhatsApp Cloud API.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "check": "node src/test-connection.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "node tests/benchmark.js",
    "report:pdf": "node scripts/generate-pdf-report.js"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-group-manager-bot",
    "group-manager",
    "group-admin",
    "gemini",
    "ai-assistant",
    "privacy",
    "chatbot",
    "meta-cloud-api"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@gradio/client": "^2.7.2",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "adm-zip": "^0.6.1",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "pdfkit": "^0.20.2",
    "prettier": "^3.9.10"
  }
}
